# Copy to .env and fill in. .env is gitignored; this file stays committed and current.

# Required for the discovery/fetch layer (SPEC 5.5): sent as user-agent contact and
# polite-pool parameter to OpenAlex, Crossref, Unpaywall. The pipeline never sends it.
CONTACT_EMAIL=you@example.com

# C3 offline mode: 1 disables every network client process-wide. Overrides config.yaml.
# OFFLINE=0

# Optional free keys (SPEC 5.2). Leave blank and the source is skipped with a log line.
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
NCBI_API_KEY=
